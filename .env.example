# =============================================================
# Template de variáveis de ambiente — copie para .env e preencha
# NUNCA commite o arquivo .env com valores reais
# =============================================================

# --- Oracle Autonomous Database (mTLS via wallet) ------------

# Usuário do banco de dados Oracle
ORACLE_USER=seu_usuario

# Senha do banco de dados Oracle
ORACLE_PASSWORD=sua_senha

# Nome do serviço conforme definido em wallet/tnsnames.ora
# Serviços disponíveis neste banco:
#   dbdados_high     — máxima prioridade de recursos (uso geral)
#   dbdados_medium   — prioridade média
#   dbdados_low      — menor prioridade (consultas longas/batch)
#   dbdados_tp       — transaction processing
#   dbdados_tpurgent — transaction processing urgente
ORACLE_DSN=dbdados_high

# Caminho para o diretório onde a wallet foi descompactada
# Use caminho relativo à raiz do projeto ou caminho absoluto
ORACLE_WALLET_DIR=./wallet
